# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the real .env file.

# Required -- generate with: openssl rand -hex 32
JWT_SECRET=

# Required -- the landlord's login for the app itself (not a real UPI/bank credential)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional -- match your host user so bind-mounted volume files aren't owned by root.
# Find your ids with `id -u` / `id -g` on Linux/macOS.
PUID=1000
PGID=1000
